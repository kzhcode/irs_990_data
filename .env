

# --- PostgreSQL Information ---
POSTGRES_USER=irs990_user
POSTGRES_PASSWORD=irs990_pass
POSTGRES_DB=irs990_db
POSTGRES_PORT=5432

# --- Airflow Information ---
# Database Connection
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://irs990_user:irs990_pass@postgres:5432/irs990_db
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# Example factory DAG's disabled
AIRFLOW__CORE__LOAD_EXAMPLES=False

# Airflow web UI credentials
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
